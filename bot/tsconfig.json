{
  "_meta": {
    "description": "TypeScript configuration for thread-watcher bot"
  },
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS", // More compatible with Node.js
    "rootDir": "./src/",
    "outDir": "./dist/",
    "strict": true,
    "moduleResolution": "node", // Must match module setting
    "importHelpers": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "removeComments": true,
    "typeRoots": ["./node_modules/@types", "./src/types"],
    "types": ["node"],
    "sourceMap": false,
    "baseUrl": "./"
  },
  "files": ["src/index.ts", "src/bot.ts"],
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
