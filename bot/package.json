{
  "name": "thread-watcher",
  "version": "0.0.0",
  "description": "A Discord bot for managing threads",
  "license": "MIT",
  "author": {
    "name": "Jonathan H (familyfriendly.xyz)"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "yarn clean && tsc",
    "start": "node ./dist/index.js",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "fix": "yarn format && yarn fix:lint",
    "fix:lint": "eslint . --ext .ts,js,mjs --fix",
    "fix:simple": "eslint . --ext .ts,js,mjs --fix --fix-type layout,problem",
    "fix:import": "eslint . --ext .ts,js --fix --rule '@typescript-eslint/no-unused-vars: 0'",
    "lint:report": "eslint . --ext .ts,js,mjs -o eslint-report.html -f html"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "discord.js": "^14.18.0",
    "express": "^4.21.2",
    "json5": "^2.2.3",
    "log75": "^3.0.1",
    "mysql": "^2.18.1",
    "node-cron": "^3.0.3",
    "topgg-autoposter": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/mysql": "^2.15.26",
    "@types/node": "^22.13.8",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "eslint": "^9.21.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0"
  },
  "packageManager": "yarn@4.7.0"
}
