{
  "name": "thread-watcher",
  "version": "0.0.0",
  "description": "A Discord bot for managing threads",
  "license": "MIT",
  "author": {
    "name": "Jonathan H (familyfriendly.xyz)"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "yarn clean && tsc",
    "start": "node ./dist/index.js",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "fix": "yarn format && yarn fix:lint",
    "fix:lint": "eslint . --ext .ts,mjs --fix",
    "fix:simple": "eslint . --ext .ts,mjs --fix --fix-type layout,problem",
    "fix:import": "eslint . --ext .ts --fix --rule '@typescript-eslint/no-unused-vars: 0'",
    "lint:report": "eslint . --ext .ts,mjs -o eslint-report.html -f html",
    "security:audit": "yarn npm audit",
    "lint:security": "eslint ./src --ext .ts --report-unused-disable-directives --max-warnings=0",
    "security:check": "yarn lint:security",
    "prestart": "yarn security:audit"
  },
  "dependencies": {
    "better-sqlite3": "12.9.0",
    "discord.js": "^14.27.0",
    "express": "^5.3.0",
    "json5": "^2.2.3",
    "log75": "^3.0.1",
    "mysql": "^2.18.1",
    "node-cron": "^4.6.0",
    "topgg-autoposter": "^2.0.2"
  },
  "dependenciesMeta": {
    "better-sqlite3": {
      "built": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/mysql": "^2.15.28",
    "@types/node": "^24.0.0",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "eslint-plugin-security": "^4.2.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.71.1"
  },
  "packageManager": "yarn@4.18.1"
}
